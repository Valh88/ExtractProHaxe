-cp server/src

-cp shared/src

#-cp /home/vano/.haxe_lib/oimophysics/git/src
-cp D:/projects/haxe/OimoPhysics/src

-lib HeapsPhysics
-lib castle
-lib hxrnl

# rnl.net model classes are resolved BY NAME over the wire (Type.resolveClass),
